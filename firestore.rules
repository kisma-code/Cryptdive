rules_version = '2';

// Cryptdive: cloud save + leaderboard.
// Paste these rules in Firebase console > Firestore Database > Rules, then push Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    // One record for each player. The document id is the player's login id (uid).
    match /players/{uid} {
      // All players can read the leaderboard (first name + scores only; no email).
      allow read: if true;

      // A player can write only their own record, with only these fields.
      // The best floor can only go up.
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'bestFloor', 'bestLevel', 'bestKills', 'weapon', 'runs', 'classes', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 16
        && request.resource.data.bestFloor is int
        && request.resource.data.bestFloor >= 0
        && request.resource.data.bestFloor <= 999
        && request.resource.data.bestLevel is int
        && request.resource.data.bestKills is int
        && request.resource.data.weapon is string
        && request.resource.data.weapon.size() <= 16
        && request.resource.data.runs is int
        // Class Souls and upgrades: one small map for each class.
        && (!('classes' in request.resource.data) || (request.resource.data.classes is map
            && request.resource.data.classes.keys().hasOnly(['laser', 'lightning', 'boomerang', 'rockets'])))
        && request.resource.data.updatedAt == request.time
        && (resource == null || request.resource.data.bestFloor >= resource.data.bestFloor);

      allow delete: if request.auth != null && request.auth.uid == uid;
    }
  }
}
